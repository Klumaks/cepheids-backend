{
    "swagger": "2.0",
    "info": {
        "description": "Спектральные классы цефеид: калибровка зависимости период–светимость, JWT и Redis blacklist.",
        "title": "Cepheids API",
        "contact": {},
        "version": "4.0"
    },
    "basePath": "/api",
    "paths": {
        "/cepheids": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Спектральные классы"
                ],
                "summary": "Спектральные классы цефеид с фильтрацией",
                "parameters": [
                    {
                        "type": "number",
                        "description": "Минимальный наклон зависимости период–светимость",
                        "name": "min_slope",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Максимальный наклон",
                        "name": "max_slope",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Минимальный свободный член",
                        "name": "min_b",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Максимальный свободный член",
                        "name": "max_b",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/ds.SpectralClass"
                            }
                        }
                    },
                    "400": {
                        "description": "Некорректный диапазон"
                    },
                    "500": {
                        "description": "Ошибка БД"
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "CepheidBearer": []
                    }
                ],
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Спектральные классы"
                ],
                "summary": "Создание черновика спектрального класса с файлами",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Название спектрального класса",
                        "name": "name",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Изображение",
                        "name": "image",
                        "in": "formData"
                    },
                    {
                        "type": "file",
                        "description": "Короткое видео",
                        "name": "video",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/ds.SpectralClass"
                        }
                    },
                    "400": {
                        "description": "Некорректные данные"
                    },
                    "401": {
                        "description": "Требуется действующий JWT"
                    },
                    "409": {
                        "description": "Черновик уже существует"
                    },
                    "500": {
                        "description": "Ошибка БД или MinIO"
                    },
                    "503": {
                        "description": "Redis недоступен"
                    }
                }
            }
        },
        "/cepheids/draft": {
            "get": {
                "security": [
                    {
                        "CepheidBearer": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Спектральные классы"
                ],
                "summary": "Черновик спектрального класса текущего наблюдателя",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ds.SpectralClass"
                        }
                    },
                    "401": {
                        "description": "Требуется действующий JWT"
                    },
                    "404": {
                        "description": "Черновика нет"
                    },
                    "500": {
                        "description": "Ошибка БД"
                    },
                    "503": {
                        "description": "Redis недоступен"
                    }
                }
            }
        },
        "/cepheids/feed": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Спектральные классы"
                ],
                "summary": "Первый опубликованный спектральный класс",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ds.SpectralClass"
                        }
                    },
                    "404": {
                        "description": "Лента пуста"
                    },
                    "500": {
                        "description": "Ошибка БД"
                    }
                }
            }
        },
        "/cepheids/feed/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Спектральные классы"
                ],
                "summary": "Спектральный класс по ID или следующий в ленте",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID спектрального класса",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "boolean",
                        "description": "Следующий опубликованный класс; в конце переход к первому",
                        "name": "next",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ds.SpectralClass"
                        }
                    },
                    "400": {
                        "description": "Некорректный ID"
                    },
                    "404": {
                        "description": "Класс не найден"
                    },
                    "500": {
                        "description": "Ошибка БД"
                    }
                }
            }
        },
        "/cepheids/{id}": {
            "delete": {
                "security": [
                    {
                        "CepheidBearer": []
                    }
                ],
                "tags": [
                    "Спектральные классы"
                ],
                "summary": "Логическое удаление своего спектрального класса",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID спектрального класса",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Спектральный класс удалён"
                    },
                    "400": {
                        "description": "Некорректный ID"
                    },
                    "401": {
                        "description": "Требуется действующий JWT"
                    },
                    "403": {
                        "description": "Чужой спектральный класс"
                    },
                    "404": {
                        "description": "Класс не найден"
                    },
                    "500": {
                        "description": "Ошибка БД"
                    },
                    "503": {
                        "description": "Redis недоступен"
                    }
                }
            }
        },
        "/cepheids/{id}/like": {
            "post": {
                "security": [
                    {
                        "CepheidBearer": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "Спектральные классы"
                ],
                "summary": "Поставить или отменить лайк спектрального класса",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID опубликованного спектрального класса",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "1 — поставить, 0 — отменить",
                        "name": "appreciation",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.CepheidLike"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Лайк обновлён"
                    },
                    "400": {
                        "description": "Допускаются только 0 и 1"
                    },
                    "401": {
                        "description": "Требуется действующий JWT"
                    },
                    "404": {
                        "description": "Класс не найден"
                    },
                    "500": {
                        "description": "Ошибка БД"
                    },
                    "503": {
                        "description": "Redis недоступен"
                    }
                }
            }
        },
        "/cepheids/{id}/publish": {
            "put": {
                "security": [
                    {
                        "CepheidBearer": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Спектральные классы"
                ],
                "summary": "Публикация своего черновика спектрального класса",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID спектрального класса",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Описание и коэффициенты период–светимость",
                        "name": "calibration",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.CepheidPublication"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ds.SpectralClass"
                        }
                    },
                    "400": {
                        "description": "Некорректные данные"
                    },
                    "401": {
                        "description": "Требуется действующий JWT"
                    },
                    "403": {
                        "description": "Чужой спектральный класс"
                    },
                    "404": {
                        "description": "Черновик не найден"
                    },
                    "500": {
                        "description": "Ошибка БД"
                    },
                    "503": {
                        "description": "Redis недоступен"
                    }
                }
            }
        },
        "/users/login": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Пользователи"
                ],
                "summary": "Вход наблюдателя цефеид",
                "parameters": [
                    {
                        "description": "Логин и пароль",
                        "name": "credentials",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.CepheidCredentials"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.CepheidLoginResponse"
                        }
                    },
                    "400": {
                        "description": "Некорректные данные"
                    },
                    "401": {
                        "description": "Неверный логин или пароль"
                    },
                    "500": {
                        "description": "Ошибка сервера"
                    }
                }
            }
        },
        "/users/logout": {
            "post": {
                "security": [
                    {
                        "CepheidBearer": []
                    }
                ],
                "tags": [
                    "Пользователи"
                ],
                "summary": "Выход наблюдателя и отзыв JWT",
                "responses": {
                    "200": {
                        "description": "JWT отозван"
                    },
                    "401": {
                        "description": "Требуется действующий JWT"
                    },
                    "503": {
                        "description": "Redis недоступен"
                    }
                }
            }
        },
        "/users/register": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Пользователи"
                ],
                "summary": "Регистрация наблюдателя цефеид",
                "parameters": [
                    {
                        "description": "Логин и пароль",
                        "name": "credentials",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.CepheidCredentials"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/ds.User"
                        }
                    },
                    "400": {
                        "description": "Некорректные данные"
                    },
                    "409": {
                        "description": "Логин занят"
                    },
                    "500": {
                        "description": "Ошибка БД"
                    }
                }
            }
        }
    },
    "definitions": {
        "ds.SpectralClass": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "creator_id": {
                    "type": "integer"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "image_key": {
                    "type": "string"
                },
                "image_url": {
                    "description": "Дополнительные поля для API ответов",
                    "type": "string"
                },
                "is_liked": {
                    "type": "integer"
                },
                "is_mine": {
                    "type": "integer"
                },
                "likes_count": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "pl_intercept": {
                    "type": "number"
                },
                "pl_slope": {
                    "type": "number"
                },
                "updated_at": {
                    "type": "string"
                },
                "video_key": {
                    "type": "string"
                },
                "video_url": {
                    "type": "string"
                }
            }
        },
        "ds.User": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "login": {
                    "type": "string"
                }
            }
        },
        "handler.CepheidCredentials": {
            "type": "object",
            "required": [
                "login",
                "password"
            ],
            "properties": {
                "login": {
                    "type": "string",
                    "example": "cepheid_observer"
                },
                "password": {
                    "type": "string",
                    "example": "observation2026"
                }
            }
        },
        "handler.CepheidLike": {
            "type": "object",
            "required": [
                "like"
            ],
            "properties": {
                "like": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "handler.CepheidLoginResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "expires_in": {
                    "type": "integer",
                    "example": 3600
                },
                "token_type": {
                    "type": "string",
                    "example": "Bearer"
                },
                "user": {
                    "$ref": "#/definitions/ds.User"
                }
            }
        },
        "handler.CepheidPublication": {
            "type": "object",
            "required": [
                "pl_intercept",
                "pl_slope"
            ],
            "properties": {
                "description": {
                    "type": "string",
                    "example": "Калибровка зависимости период–светимость"
                },
                "pl_intercept": {
                    "type": "number",
                    "example": -1.4
                },
                "pl_slope": {
                    "type": "number",
                    "example": -2.76
                }
            }
        }
    },
    "securityDefinitions": {
        "CepheidBearer": {
            "description": "Введите Bearer и JWT из ответа /api/users/login.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}